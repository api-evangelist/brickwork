            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.brickworksoftware.com/:locale/api/v3/admin/customers/:customer_id_or_code/transactions",
            "params": [
              {
                "name": "customer_id_or_code",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "Customer Transactions"
        },
        {
          "info": {
            "name": "Index Transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.brickworksoftware.com/:locale/api/v3/admin/transactions",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of your query"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Query parameters for all company transactions"
              },
              {
                "name": "query[start_date]",
                "value": "",
                "type": "query",
                "description": "Company transactions select start date \"YYYY-MM-DD\", defaults to 30 days back"
              },
              {
                "name": "query[end_date]",
                "value": "",
                "type": "query",
                "description": "Company transactions select end date \"YYYY-MM-DD\", defaults to today"
              },
              {
                "name": "query[code]",
                "value": "",
                "type": "query",
                "description": "Filter transactions by codes [1,2,3]"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "Example: `http://company.com/api/v3/admin/transactions?query[start_date]=2016-05-28`"
        },
