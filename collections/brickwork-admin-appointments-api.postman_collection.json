          "name": "List all Appointments",
          "request": {
            "name": "List all Appointments",
            "description": {
              "content": "Example: `http://company.com/api/v3/admin/appointments?query[start_date]=2016-05-28&query[filter_start_time]=true`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":locale",
