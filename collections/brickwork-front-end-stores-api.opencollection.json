            "name": "Store Featured Associates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.brickworksoftware.com/api/v3/stores/:store_id_or_slug/featured_associates",
            "params": [
              {
                "name": "store_id_or_slug",
