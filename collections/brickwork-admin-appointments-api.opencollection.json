          },
          "docs": "Example: `http://company.com/api/v3/stores/:store_id/appointments/`\n\nExample: `http://company.com/api/v3/stores/:store_number/appointments/?store_number=true`"
        }
      ]
    }
  ],
  "bundled": true
}