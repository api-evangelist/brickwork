{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brickwork Admin Appointments Admin Customer Appointments API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Admin Customer Appointments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all customer appointments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.brickworksoftware.com/:locale/api/v3/admin/customers/:customer_id_or_code/appointments",
            "params": [
              {
                "name": "customer_id_or_code",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "Example: `http://company.com/api/v3/customers/:customer_id/appointments`\n\nExample: `http://company.com/api/v3/customers/:customer_code/appointments`"
        }
      ]
    }
  ],
  "bundled": true
}