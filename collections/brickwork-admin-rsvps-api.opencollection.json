{
  "opencollection": "1.0.0",
  "info": {
    "name": "Brickwork Admin Appointments Admin Rsvps API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Admin Rsvps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Rsvps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://production.brickworksoftware.com/:locale/api/v3/admin/rsvps",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of your query"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Query parameters for all company events ex: &query[start_date]=2016-05-28"
              },
              {
                "name": "query[start_date]",
                "value": "",
                "type": "query",
                "description": "Company events select start date \"YYYY-MM-DD\", defaults to 30 days back"
              },
              {
                "name": "query[end_date]",
                "value": "",
                "type": "query",
                "description": "Company events select end date \"YYYY-MM-DD\", defaults to today"
              },
              {
                "name": "query[store_event_ids]",
                "value": "",
                "type": "query",
                "description": "Filter rsvps by store event ids [1,2,3]"
              },
              {
                "name": "query[event_ids]",
                "value": "",
                "type": "query",
                "description": "Filter rsvps by event ids [1,2,3]"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_key",
              "value": "{{api_key}}",
              "placement": "query"
            }
          },
          "docs": "Example: `http://company.com/api/v3/admin/rsvps?query[start_date]=2016-05-28`"
        }
      ]
    }
  ],
  "bundled": true
}