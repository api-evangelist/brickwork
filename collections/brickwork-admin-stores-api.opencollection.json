              },
              {
                "name": "number",
                "value": "",
                "type": "query",
                "description": "Query stores by number"
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "Query stores by state"
              },
              {
                "name": "country_code",
                "value": "",
